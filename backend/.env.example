# Copiar este archivo como .env y completar con los valores reales (el .env NO se sube a Git).

# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/gimnasio
PORT=3000

# "production" en el hosting: activa la cookie de sesión con Secure (solo HTTPS).
# En local se deja "development".
NODE_ENV=development

# Clave para firmar los tokens de sesión (JWT). Larga, aleatoria y distinta en cada entorno.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Primer administrador: solo los usa "npm run seed:admin" (contraseña de 8 caracteres o más).
# Después de crearlo se pueden borrar de este archivo.
ADMIN_NOMBRE=Nombre Apellido
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA
